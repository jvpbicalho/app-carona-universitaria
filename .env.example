# Projeto Supabase (organização GAP 2026 / app-carona-universitaria).
# Copie para .env — .env não é versionado.
#
# A publishable key é pública por design (vai embutida no bundle do app).
# O que protege os dados é RLS, não o segredo da chave.
EXPO_PUBLIC_SUPABASE_URL=https://scfazxgfzcvjfxtckqic.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Domínios institucionais aceitos no cadastro, separados por vírgula.
# Esta lista é a validação de UX no client. A autoridade é a tabela
# public.allowed_email_domains + o trigger em auth.users; mantenha as duas
# em sincronia ao adicionar um domínio.
EXPO_PUBLIC_INSTITUTIONAL_EMAIL_DOMAINS=pucsp.edu.br
